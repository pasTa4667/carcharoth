        {
          "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (report #>> '{metrics,rmse}')::double precision AS rmse,\n  (report #>> '{metrics,mae}')::double precision AS mae,\n  (report #>> '{metrics,spearman}')::double precision AS spearman,\n  (report #>> '{diagnostics,prediction_vs_actual,total_rows}')::integer AS validation_rows\nFROM model_diagnostics\nWHERE model_id = '${model}'",
          "refId": "A"
        }
      ],
      "title": "Validation Summary",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
      "fieldConfig": {
        "defaults": { "custom": { "axisLabel": "Actual forward log return", "axisPlacement": "auto", "drawStyle": "points", "pointSize": 3 }, "decimals": 6 },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
