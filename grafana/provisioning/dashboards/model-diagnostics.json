      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (point->>'prediction')::double precision AS prediction,\n  (point->>'actual')::double precision AS actual\nFROM model_diagnostics\nCROSS JOIN LATERAL jsonb_array_elements(report #> '{diagnostics,prediction_vs_actual,scatter}') AS point\nWHERE model_id = '${model}'\nORDER BY prediction",
          "refId": "A"
        }
      ],
      "title": "Prediction vs Actual (validation sample)",
      "type": "xychart"
    },
    {
      "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
      "fieldConfig": { "defaults": { "decimals": 6 }, "overrides": [] },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "options": {
        "barRadius": 0,
        "barWidth": 0.8,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "auto",
        "showValue": "never",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "none" },
