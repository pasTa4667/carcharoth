      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  'D' || (bucket->>'decile') AS decile,\n  (bucket->>'prediction_mean')::double precision AS prediction_mean,\n  (bucket->>'actual_mean')::double precision AS actual_mean\nFROM model_diagnostics\nCROSS JOIN LATERAL jsonb_array_elements(report #> '{diagnostics,prediction_deciles}') AS bucket\nWHERE model_id = '${model}'\nORDER BY (bucket->>'decile')::integer",
          "refId": "A"
        }
      ],
      "title": "Prediction Deciles",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "options": {
        "barRadius": 0,
        "barWidth": 1,
        "fullHighlight": false,
        "groupWidth": 1,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
