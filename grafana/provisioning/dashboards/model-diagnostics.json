        "showValue": "never",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  round((bin->>'midpoint')::numeric, 6)::text AS return_bin,\n  (bin->>'prediction_count')::integer AS predictions,\n  (bin->>'actual_count')::integer AS actuals\nFROM model_diagnostics\nCROSS JOIN LATERAL jsonb_array_elements(report #> '{diagnostics,distributions,bins}') AS bin\nWHERE model_id = '${model}'\nORDER BY (bin->>'midpoint')::double precision",
          "refId": "A"
        }
      ],
      "title": "Prediction and Actual Distributions",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
      "fieldConfig": { "defaults": { "decimals": 4 }, "overrides": [] },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "options": {
        "barRadius": 0,
        "barWidth": 0.8,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "horizontal",
        "showValue": "never",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "carcharoth-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  importance->>'feature' AS feature,\n  (importance->>'gain_normalized')::double precision AS normalized_gain,\n  (importance->>'permutation_rmse_increase')::double precision AS permutation_rmse_increase\nFROM model_diagnostics\nCROSS JOIN LATERAL jsonb_array_elements(report #> '{diagnostics,feature_importance}') AS importance\nWHERE model_id = '${model}'\nORDER BY (importance->>'permutation_rmse_increase')::double precision DESC",
          "refId": "A"
        }
      ],
      "title": "Feature Importance",
      "type": "barchart"
    },
    {
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 26 },
      "id": 6,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "Feature importance is associative, not causal. Correlated features can split or dilute both gain and permutation importance. Deciles, distributions, and scatter aggregates use the chronological validation set; repeatedly tuning against that set will overfit it. Confirm changes on a later out-of-sample backtest.",
