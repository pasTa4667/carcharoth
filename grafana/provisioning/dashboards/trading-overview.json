          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_assignments AS (\n  SELECT DISTINCT ON (symbol) symbol, strategy, regime, since\n  FROM strategy_assignments\n  ORDER BY symbol, since DESC\n)\nSELECT\n  la.symbol,\n  la.strategy,\n  la.regime,\n  la.since,\n  CASE\n    WHEN ps.qty > 0 THEN 'OPEN'\n    ELSE 'FLAT'\n  END AS position_status,\n  COALESCE(ps.unrealized_pnl, 0) AS position_pnl\nFROM latest_assignments la\nLEFT JOIN positions_snapshot ps ON la.symbol = ps.symbol \n  AND ps.timestamp = (SELECT MAX(timestamp) FROM positions_snapshot)\nORDER BY la.symbol",
