          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH feature_data AS (\n  SELECT\n    timestamp,\n    symbol,\n    regime,\n    score,\n    directional_score,\n    stability,\n    jsonb_object_keys(features) AS feature_name,\n    (features ->> jsonb_object_keys(features))::numeric AS feature_value\n  FROM regime_evaluations\n  WHERE $__timeFilter(timestamp)\n    AND symbol IN (${symbol:sqlstring})\n)\nSELECT\n  timestamp,\n  symbol,\n  regime,\n  ROUND(score::numeric, 3) AS score,\n  ROUND(directional_score::numeric, 3) AS directional_score,\n  ROUND(stability::numeric, 3) AS stability,\n  string_agg(feature_name || '=' || ROUND(feature_value::numeric, 3), ', ' ORDER BY feature_name) AS features\nFROM feature_data\nGROUP BY timestamp, symbol, regime, score, directional_score, stability\nORDER BY timestamp DESC\nLIMIT 30",
