sequenceDiagram
  participant Driver as Scheduler / BacktestRunner
  participant Engine as TradingEngine
  participant Data as MarketDataService
  participant Account as AccountService
  participant Model as ModelSignalGenerator
  participant Risk as RiskManager
  participant Exec as OrderExecutor
  Driver->>Engine: tick()
  Engine->>Exec: reconcile open orders
  Engine->>Model: market_requirements()
  Engine->>Data: get_snapshot(tradables + context, BarSpec)
  Engine->>Account: get_account_state()
  loop tradable symbols only
    Engine->>Model: generate(symbol, snapshot, position)
    Model-->>Engine: LONG / SHORT / FLAT / UNCHANGED
    alt actionable target
      Engine->>Risk: assess(intent, account, quote)
      Risk-->>Engine: side + qty or rejection
      Engine->>Exec: submit approved order
    end
  end
