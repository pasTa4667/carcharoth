---
title: System layers — dependencies point inward, toward interfaces and domain
---
flowchart TB
    subgraph Entry["🚪 Entry / Composition"]
        direction LR
        MAIN["main.py<br/><small>composition root + CLI</small>"]:::entry
        SCHED["Scheduler"]:::entry
    end

    subgraph Core["⚙️ Orchestration — provider-agnostic"]
        direction LR
        ENGINE["TradingEngine.tick()<br/><small>the fixed 5-step sequence</small>"]:::engine
        SP["StrategyProvider<br/><small>single / regime</small>"]:::engine
    end

    subgraph Contracts["📜 interfaces/ — ABCs & Protocols"]
        direction LR
        I_BROKER(["MarketDataService<br/>AccountService<br/>OrderExecutor · MarketClock"]):::iface
        I_LOGIC(["Strategy<br/>RegimeDetector<br/>RiskManager"]):::iface
        I_INFRA(["Repository ABCs<br/>Cache / ByteStore<br/>ParameterOptimizer"]):::iface
    end

    subgraph Impl["🔌 Concrete implementations"]
        direction LR
        ALPACA["services/alpaca/<br/><small>live</small>"]:::io
        BT["services/backtest/<br/><small>simulated</small>"]:::sim
        LOGIC["strategies/ · regime/<br/>risk/"]:::logic
        INFRA["persistence/ · services/cache/<br/>services/optuna/"]:::infra
    end

    DOMAIN["💎 domain/models.py &nbsp;·&nbsp; analysis/<br/><small>pure, no I/O — flows between every layer</small>"]:::pure

    MAIN ==> SCHED ==> ENGINE ==> SP

    ENGINE --> I_BROKER
    ENGINE --> I_INFRA
    SP --> I_LOGIC

    I_BROKER -.- ALPACA
    I_BROKER -.- BT
    I_LOGIC -.- LOGIC
    I_INFRA -.- INFRA

    Impl ==> DOMAIN
    Contracts ==> DOMAIN
    MAIN -. "wires the concrete<br/>implementations<br/>(the only seam)" .-> Impl

    LEGEND{{"solid = calls / depends on &nbsp;·&nbsp; dotted = implements"}}:::note

