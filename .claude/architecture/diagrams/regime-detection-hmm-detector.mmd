---
title: HmmRegimeDetector — lazy fit, cached refit, posterior inference
---
flowchart TD
    BARS[("bars")]:::data --> FEAT["features.py — observation matrix<br/><small>[log return, rolling log-vol,<br/>EMA-distance, ADX]<br/>NaN warm-up rows dropped</small>"]:::feature
    FEAT --> NEEDFIT{"fit / refit needed?<br/><small>first call, or refit_interval_bars<br/>new bars since last fit</small>"}:::decision

    NEEDFIT -- yes --> CACHE{"HmmFitCache hit?"}:::decision
    CACHE -- hit --> USE["fitted model"]:::regime
    CACHE -- "miss / disabled" --> FIT["fit GaussianHMM<br/><small>seeded per symbol → reproducible</small>"]:::fit
    FIT --> STORE[("store in Redis<br/><small>seed-deterministic ⇒ a cached fit is<br/>bit-identical to a fresh one</small>")]:::cache
    STORE --> USE
    NEEDFIT -- no --> USE

    USE --> LABEL["labeling.py<br/><small>hidden state → regime,<br/>derived from emission means</small>"]:::regime
    LABEL --> INFER["posterior of the newest bar"]:::regime
    INFER ==> OUT(["RegimeAssessment<br/><small>regime + full probability distribution</small>"]):::done

    KEY{{"key: carch:hmm:v1:{config_hash}:{symbol}:{obs_hash}<br/>config_hash covers fit-relevant fields + hmmlearn version"}}:::note
    KEY -.-> CACHE

    classDef data fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#0f172a
    classDef feature fill:#f0fdfa,stroke:#0d9488,stroke-width:2px,color:#0f172a
    classDef regime fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#0f172a
    classDef fit fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#0f172a
    classDef cache fill:#cffafe,stroke:#0891b2,stroke-width:2px,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#0f172a
    classDef done fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a
    classDef note fill:#fffbeb,stroke:#a16207,stroke-width:1px,color:#0f172a,font-style:italic
