---
title: Backtest flow — historical replay through the unchanged engine
---
flowchart TB
    CLI(["carcharoth backtest<br/>--start … --end …"]):::entry

    CLI --> FETCH["fetch_historical_bars()<br/><small>incl. warm-up window</small>"]:::io
    FETCH <--> CACHE[("bars cache<br/>in-process → Redis<br/><small>gap-filled, cross-run</small>")]:::cache

    FETCH -- bars --> LOOP

    subgraph LOOP["BacktestRunner · one iteration per session bar (no scheduler)"]
        direction TB
        ADV["market_data.advance_to(ts)<br/><small>move the simulated 'now'</small>"]:::sim
        MTM["broker.mark_to_market(ts, closes)<br/><small>reprice positions, roll equity</small>"]:::sim
        TICK["TradingEngine.tick()<br/><small>unchanged live 5-step sequence</small>"]:::engine
        ADV --> MTM --> TICK
    end

    LOOP -- "loop ends" --> REC["final reconcile pass"]:::engine
    REC --> AN["BacktestAnalyzer<br/><small>metrics + fitness_&lt;name&gt;</small>"]:::analysis
    AN --> DB[("backtest_metrics<br/><small>run-scoped</small>")]:::db

    SWAP{{"wired in main.py instead of the Alpaca services:<br/>HistoricalMarketDataService · SimulatedBroker"}}:::note
    SWAP -.-> LOOP

